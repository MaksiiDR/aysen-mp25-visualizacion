/// Tabla de hechos diaria de MP2,5, otros contaminantes y meteorologia (regla DS N 12/2011 >=18h).
table 'Calidad Aire Diaria'
	lineageTag: 3743736c-3233-4f70-8aa2-6799bafdeb01

	/// Promedio diario 24h de MP2,5 en ug/m3 sobre dias validos (>=18 horas).
	measure 'MP2,5 Promedio 24h' = AVERAGE('Calidad Aire Diaria'[MP2,5 24h])
		formatString: #,##0.0 "ug/m3"
		displayFolder: Calidad del Aire
		lineageTag: 87175002-0ed8-45ce-8aa8-551a10d35b7f

	/// Mediana diaria 24h de MP2,5 en ug/m3.
	measure 'MP2,5 Mediana 24h' = MEDIAN('Calidad Aire Diaria'[MP2,5 24h])
		formatString: #,##0.0 "ug/m3"
		displayFolder: Calidad del Aire
		lineageTag: 26a16c8d-b806-48bf-b9a8-0e243dd2b26a

	/// Percentil 90 de concentracion diaria 24h de MP2,5.
	measure 'MP2,5 Percentil 90' =
			PERCENTILEX.INC(
				FILTER('Calidad Aire Diaria', NOT(ISBLANK('Calidad Aire Diaria'[MP2,5 24h]))),
				'Calidad Aire Diaria'[MP2,5 24h],
				0.90
			)
		formatString: #,##0.0 "ug/m3"
		displayFolder: Calidad del Aire
		lineageTag: fa80f184-df89-49c8-b5dd-e34a6efbd460

	/// Cantidad de dias con al menos 18 horas validas de medicion MP2,5.
	measure 'Dias Validos' =
			CALCULATE(
				COUNTROWS('Calidad Aire Diaria'),
				'Calidad Aire Diaria'[Dia Valido MP2,5] = TRUE()
			)
		formatString: #,##0
		displayFolder: Calidad del Aire
		lineageTag: 91c71968-3122-45db-a867-8c503d32f486

	/// Cantidad de dias validos que superan la norma diaria DS 12 (>50 ug/m3).
	measure 'Dias Sobre Norma' =
			CALCULATE(
				COUNTROWS('Calidad Aire Diaria'),
				'Calidad Aire Diaria'[Sobre Norma 50] = 1
			)
		formatString: #,##0
		displayFolder: Calidad del Aire
		lineageTag: 855988a4-81d2-4671-b264-d069cfa14577

	/// Porcentaje de dias validos que superan los 50 ug/m3.
	measure 'Tasa Episodios' = DIVIDE([Dias Sobre Norma], [Dias Validos], 0)
		formatString: 0.0%
		displayFolder: Calidad del Aire
		lineageTag: 7dcddf85-2e6f-4c6c-8934-3edfe6cabd73

	/// Dias sobre norma dentro de la ventana comparable 1 ene - 23 oct.
	measure 'Dias Sobre Norma YTD' =
			CALCULATE(
				[Dias Sobre Norma],
				Calendario[Ventana YTD Comparable] = TRUE()
			)
		formatString: #,##0
		displayFolder: Calidad del Aire
		lineageTag: 2d4c9932-ee3b-4c22-8d0f-91e87301cb4f

	/// Promedio 24h de MP2,5 restringido a temporada invernal (abril-septiembre).
	measure 'MP2,5 Promedio Invierno' =
			CALCULATE(
				[MP2,5 Promedio 24h],
				Calendario[Temporada Invernal] = TRUE()
			)
		formatString: #,##0.0 "ug/m3"
		displayFolder: Calidad del Aire
		lineageTag: 10ef663a-d60d-4f72-90db-15fd0ff0ce45

	/// Dias clasificados en Alerta ambiental GEC (80-109 ug/m3).
	measure 'Dias Alerta' =
			CALCULATE(
				COUNTROWS('Calidad Aire Diaria'),
				'Calidad Aire Diaria'[Categoria GEC] = "Alerta (80-109)"
			)
		formatString: #,##0
		displayFolder: Episodios GEC
		lineageTag: e9f8f614-a19e-4752-aec9-6018479ee5d4

	/// Dias clasificados en Preemergencia ambiental GEC (110-169 ug/m3).
	measure 'Dias Preemergencia' =
			CALCULATE(
				COUNTROWS('Calidad Aire Diaria'),
				'Calidad Aire Diaria'[Categoria GEC] = "Preemergencia (110-169)"
			)
		formatString: #,##0
		displayFolder: Episodios GEC
		lineageTag: 5d4709d4-4d99-4229-9e8f-ac0ba1622176

	/// Dias clasificados en Emergencia ambiental GEC (>=170 ug/m3).
	measure 'Dias Emergencia' =
			CALCULATE(
				COUNTROWS('Calidad Aire Diaria'),
				'Calidad Aire Diaria'[Categoria GEC] = "Emergencia (>=170)"
			)
		formatString: #,##0
		displayFolder: Episodios GEC
		lineageTag: 80a87e13-2bb4-4684-bf5d-c90535bd06a6

	/// Porcentaje de dias calendario registrados que cumplen criterio >=18 horas validas.
	measure 'Completitud MP2,5' = DIVIDE([Dias Validos], COUNTROWS('Calidad Aire Diaria'), 0)
		formatString: 0.0%
		displayFolder: Calidad de Datos
		lineageTag: 7e6c2442-9869-42f7-b7a2-1efcf23e1bd9

	/// Proporcion de dias validos con estado preliminar o no validado en SINCA.
	measure 'Datos Preliminares' =
			VAR DiasNoVal =
				CALCULATE(
					COUNTROWS('Calidad Aire Diaria'),
					'Calidad Aire Diaria'[Dia Valido MP2,5] = TRUE(),
					'Calidad Aire Diaria'[Calidad Dato Dia] <> "validado"
				)
			RETURN
				DIVIDE(DiasNoVal, [Dias Validos], 0)
		formatString: 0.0%
		displayFolder: Calidad de Datos
		lineageTag: d06c91fc-8edc-45e2-830e-1b8e166c6976

	/// Temperatura media diaria en grados Celsius.
	measure 'Temperatura Media' = AVERAGE('Calidad Aire Diaria'[Temperatura])
		formatString: 0.0 "C"
		displayFolder: Meteorologia
		lineageTag: f01d7f39-76b9-464d-8c76-4280360d8072

	/// Temperatura media en dias con episodios sobre norma (>50 ug/m3).
	measure 'Temperatura en Episodios' =
			CALCULATE(
				AVERAGE('Calidad Aire Diaria'[Temperatura]),
				'Calidad Aire Diaria'[Sobre Norma 50] = 1
			)
		formatString: 0.0 "C"
		displayFolder: Meteorologia
		lineageTag: 5f5ecea5-787a-4ead-b34e-d17fc30705a1

	/// Velocidad media diaria del viento en m/s.
	measure 'Viento Medio' = AVERAGE('Calidad Aire Diaria'[Velocidad Viento])
		formatString: 0.00 "m/s"
		displayFolder: Meteorologia
		lineageTag: 7c7d45f5-0b08-4486-b4f4-4d3dcc8dbcd7

	/// Velocidad media del viento durante dias con episodios (>50 ug/m3).
	measure 'Viento en Episodios' =
			CALCULATE(
				AVERAGE('Calidad Aire Diaria'[Velocidad Viento]),
				'Calidad Aire Diaria'[Sobre Norma 50] = 1
			)
		formatString: 0.00 "m/s"
		displayFolder: Meteorologia
		lineageTag: 9406fe77-eb6d-464e-bb76-1cdc73efd806

	/// Humedad relativa media diaria en porcentaje.
	measure 'Humedad Media' = AVERAGE('Calidad Aire Diaria'[Humedad])
		formatString: 0.0 "%"
		displayFolder: Meteorologia
		lineageTag: 8ea558f1-93cb-4a87-83e9-b3d2a7c1ba9b

	column Fecha
		dataType: dateTime
		isHidden
