/// Perfil horario por mes del MP2,5 (24 horas x 12 meses por estacion).
table 'Ciclo Horario Mensual'

	/// Promedio horario de MP2,5 en ug/m3 para la combinacion estacion-mes-hora.
	measure 'MP2,5 Horario Promedio' = AVERAGE('Ciclo Horario Mensual'[MP2,5 Medio])
		formatString: #,##0.0
		displayFolder: Ciclo Diario

	/// Percentil 90 horario de MP2,5 en ug/m3.
	measure 'MP2,5 Horario P90' = AVERAGE('Ciclo Horario Mensual'[MP2,5 P90])
		formatString: #,##0.0
		displayFolder: Ciclo Diario

	column 'Estacion ID'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: station_id

	column Mes
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: month

	column Hora
		dataType: int64
		formatString: 00
		summarizeBy: none
		sourceColumn: hour

	column 'MP2,5 Medio'
		dataType: decimal
		formatString: #,##0.0
		summarizeBy: none
		sourceColumn: mp25_mean

	column 'MP2,5 Mediana'
		dataType: decimal
		formatString: #,##0.0
		summarizeBy: none
		sourceColumn: mp25_median

	column 'MP2,5 P90'
		dataType: decimal
		formatString: #,##0.0
		summarizeBy: none
		sourceColumn: mp25_p90

	column Observaciones
		dataType: int64
		formatString: #,##0
		summarizeBy: none
		sourceColumn: n_obs

	partition 'Ciclo Horario Mensual' = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(#"CarpetaDatos" & "\fact_ciclo_horario_mensual.csv"), [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"station_id", type text}, {"month", Int64.Type}, {"hour", Int64.Type}, {"mp25_mean", type number}, {"mp25_median", type number}, {"mp25_p90", type number}, {"n_obs", Int64.Type}}, "en-US")
			in
				#"Changed Type"
