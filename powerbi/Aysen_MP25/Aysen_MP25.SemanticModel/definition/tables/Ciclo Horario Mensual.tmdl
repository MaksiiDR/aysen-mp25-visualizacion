/// Perfil horario por mes del MP2,5 (24 horas x 12 meses por estacion).
table 'Ciclo Horario Mensual'
	lineageTag: c37eab65-21d2-4504-a934-51d5aa7411a7

	/// Promedio horario de MP2,5 en ug/m3 para la combinacion estacion-mes-hora.
	measure 'MP2,5 Horario Promedio' = AVERAGE('Ciclo Horario Mensual'[MP2,5 Medio])
		formatString: #,##0.0
		displayFolder: Ciclo Diario
		lineageTag: d80e91e9-0313-4443-a22a-850c8193dfa9

	/// Percentil 90 horario de MP2,5 en ug/m3.
	measure 'MP2,5 Horario P90' = AVERAGE('Ciclo Horario Mensual'[MP2,5 P90])
		formatString: #,##0.0
		displayFolder: Ciclo Diario
		lineageTag: 18da3cc4-7be4-4aab-8d16-d5db83f0dffd

	column 'Estacion ID'
		dataType: string
		isHidden
		lineageTag: 8e52a401-ca49-4bdf-877c-e103c7b3d9a8
		summarizeBy: none
		sourceColumn: station_id

	column Mes
		dataType: int64
		formatString: 0
		lineageTag: d29140b2-919e-454b-bd4b-7404c9810d7c
		summarizeBy: none
		sourceColumn: month

	column Hora
		dataType: int64
		formatString: 00
		lineageTag: b59ad7c1-6894-4aea-8572-746ce3a4309e
		summarizeBy: none
		sourceColumn: hour

	column 'MP2,5 Medio'
		dataType: double
		formatString: #,##0.0
		lineageTag: 5dadd01d-fee6-4738-9fe2-864c01c69240
		summarizeBy: sum
		sourceColumn: mp25_mean

		annotation SummarizationSetBy = Automatic

	column 'MP2,5 Mediana'
		dataType: double
		formatString: #,##0.0
		lineageTag: cb85a45f-f80a-48e4-b104-7ec034e16a80
		summarizeBy: sum
		sourceColumn: mp25_median

		annotation SummarizationSetBy = Automatic

	column 'MP2,5 P90'
		dataType: double
		formatString: #,##0.0
		lineageTag: 8e4805ca-0691-4430-8841-85a00b79bb95
		summarizeBy: sum
		sourceColumn: mp25_p90

		annotation SummarizationSetBy = Automatic

	column Observaciones
		dataType: int64
		formatString: #,##0
		lineageTag: 8d634873-5945-4da0-9dab-0a30c16e7e41
		summarizeBy: none
		sourceColumn: n_obs

	partition 'Ciclo Horario Mensual' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(#"CarpetaDatos" & "\fact_ciclo_horario_mensual.csv"), [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.None]),
					#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"station_id", type text}, {"month", Int64.Type}, {"hour", Int64.Type}, {"mp25_mean", type number}, {"mp25_median", type number}, {"mp25_p90", type number}, {"n_obs", Int64.Type}}, "en-US")
				in
					#"Changed Type"

