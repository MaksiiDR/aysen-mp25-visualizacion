/// Regimenes ambientales diarios identificados por PCA + K-Means (k=3) en Coyhaique II (2015-2026).
table 'Clusters PCA'
	lineageTag: 6c31b538-308a-46aa-aa4b-9991d02d0055

	/// Promedio de la primera componente principal (gradiente termico y viento).
	measure 'PC1 Promedio' = AVERAGE('Clusters PCA'[PC1])
		formatString: 0.00
		displayFolder: Regimenes PCA
		lineageTag: e9af044f-2a1a-4ba1-adbd-b9018e9994af

	/// Promedio de la segunda componente principal (humedad y presion atmosferica).
	measure 'PC2 Promedio' = AVERAGE('Clusters PCA'[PC2])
		formatString: 0.00
		displayFolder: Regimenes PCA
		lineageTag: f6356204-609e-454d-9645-843d23c07f4b

	/// Cantidad de dias asignados al regimen ambiental.
	measure 'Dias en Regimen' = COUNTROWS('Clusters PCA')
		formatString: #,##0
		displayFolder: Regimenes PCA
		lineageTag: b37377b0-321e-4412-b221-8f575ee7f8bb

	/// Concentracion media 24h de MP2,5 (ug/m3) dentro del regimen.
	measure 'MP2,5 Promedio Regimen' = AVERAGE('Clusters PCA'[MP2,5 24h])
		formatString: #,##0.0
		displayFolder: Regimenes PCA
		lineageTag: 3103f575-3f78-4bf7-a5db-d99f65e6ee88

	column Fecha
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 5cf20ab7-6021-43a4-a32d-c7169154b427
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

	column 'Estacion ID'
		dataType: string
		isHidden
		lineageTag: fd5de60d-a9bd-406f-b70b-7359e8559830
		summarizeBy: none
		sourceColumn: station_id

	column PC1
		dataType: double
		formatString: 0.00
		lineageTag: 1ef6b4b8-d83e-4d8b-9829-8b914b92c9cd
		summarizeBy: sum
		sourceColumn: PC1

		annotation SummarizationSetBy = Automatic

	column PC2
		dataType: double
		formatString: 0.00
		lineageTag: 555e6642-8f81-4db7-af4e-58f343770644
		summarizeBy: sum
		sourceColumn: PC2

		annotation SummarizationSetBy = Automatic

	column PC3
		dataType: double
		formatString: 0.00
		lineageTag: 610e2eed-e074-455c-a0f9-81962761a65f
		summarizeBy: sum
		sourceColumn: PC3

		annotation SummarizationSetBy = Automatic

	column 'Cluster ID'
		dataType: int64
		formatString: 0
		lineageTag: caab1d0e-1b1b-4a87-bdbe-63fd10764b7a
		summarizeBy: none
		sourceColumn: cluster_id

	/// Nombre interpretativo del regimen ambiental.
	column Regimen
		dataType: string
		lineageTag: 249ebc6b-ee85-4dfb-acba-9cb5f034d8c9
		summarizeBy: none
		sourceColumn: cluster_name
		sortByColumn: 'Cluster ID'

	column 'MP2,5 24h'
		dataType: double
		formatString: #,##0.0
		lineageTag: eba8b729-5eaf-4126-82de-b7774fce8352
		summarizeBy: sum
		sourceColumn: mp25_24h

		annotation SummarizationSetBy = Automatic

	column 'Sobre Norma 50'
		dataType: double
		formatString: 0
		lineageTag: 689564e3-5164-4d44-a27a-353eb245f630
		summarizeBy: sum
		sourceColumn: over_norm_50

		annotation SummarizationSetBy = Automatic

	partition 'Clusters PCA' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(#"CarpetaDatos" & "\fact_clusters_pca.csv"), [Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.None]),
					#"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					#"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"date", type date}, {"station_id", type text}, {"PC1", type number}, {"PC2", type number}, {"PC3", type number}, {"cluster_id", Int64.Type}, {"cluster_name", type text}, {"mp25_24h", type number}, {"over_norm_50", type number}}, "en-US")
				in
					#"Changed Type"

